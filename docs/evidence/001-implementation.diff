+def test_sentence_chunking_contract(text: str, size: int, expected: list[str]) -> None:
+    chunks = split_text_by_sentences(text, chunk_size=size)
+    assert chunks == expected
+    assert " ".join(chunks) == " ".join(text.split())
+
