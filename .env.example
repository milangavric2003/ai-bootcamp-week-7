# Copy to .env and add the key locally. Process environment overrides this file.
# Default mode stays offline; set ANSWER_BACKEND=gemma to opt in.
ANSWER_BACKEND=extractive
# Optional local semantic retrieval; prepare the pinned model before selecting it.
RAG_RETRIEVAL_BACKEND=lexical
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Used only after both transiently failed primary attempts; empty disables fallback.
GEMMA_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMMA_TEMPERATURE=0
GEMMA_MAX_OUTPUT_TOKENS=1024
GEMMA_THINKING_LEVEL=minimal
GEMMA_TIMEOUT_SECONDS=30
# Optional fresh JSONL evidence path, e.g. docs/evidence/005-gemma/live/answers.jsonl
GEMMA_TRACE_PATH=
